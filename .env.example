ANTHROPIC_API_KEY=coloque_sua_chave_aqui
SUPABASE_URL=coloque_a_url_do_seu_projeto_supabase
SUPABASE_ANON_KEY=coloque_a_anon_key_do_seu_projeto_supabase
PORT=3000

# Observabilidade (opcional) — sem essa variável, os erros continuam só no
# console.error / log do Render, sem enviar pra lugar nenhum.
SENTRY_DSN=coloque_a_dsn_do_seu_projeto_sentry

# Google Calendar (OAuth) — veja o README, seção "Google Calendar via OAuth"
GOOGLE_CLIENT_ID=coloque_o_client_id_do_google_cloud
GOOGLE_CLIENT_SECRET=coloque_o_client_secret_do_google_cloud
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=gere_uma_chave_aleatoria_de_32_bytes_em_base64
OAUTH_STATE_SECRET=gere_outra_chave_aleatoria_separada
